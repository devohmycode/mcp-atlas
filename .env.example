# Copy to .env and fill in. `npm run crawl` reads it; .env is never committed.
# In GitHub Actions, set the same names as repository secrets instead.

# Glama: https://glama.ai (account settings > API keys)
GLAMA_API_KEY=

# PulseMCP: both are required together
PULSEMCP_API_KEY=
PULSEMCP_TENANT_ID=
